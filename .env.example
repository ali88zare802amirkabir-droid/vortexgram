# Copy this file to `.env` and fill in real values.
# `.env` is gitignored (contains secrets) — only this template is committed.

PORT=3000

# Security
# Trust one front proxy (Render: set NODE_ENV=production and TRUST_PROXY=1 in
# the dashboard). While TRUST_PROXY is off, X-Forwarded-For is never trusted and
# clients cannot spoof their IP for rate limits.
TRUST_PROXY=0
# Deleted-message archive retention, in days. Expired rows are purged on boot and hourly.
MESSAGE_DELETION_RETENTION_DAYS=30
# Optional: extra allowed WebSocket origins (comma separated host names).
# VX_ALLOWED_ORIGIN=
# Optional: where file-backend sessions are stored instead of data/db.json.
# Defaults to <your-db-file>.sessions.json (gitignored).
# SESSIONS_FILE=
# Test mode: return the OTP code in the API response even in production.
# Do NOT enable unless you are testing without a working SMS provider.
# VX_ALLOW_DEV_CODE=1
# Security: by default the OTP code is returned in the page (this demo needs no
# SMS). Set VX_HIDE_CODE=1 to stop returning it — then the code ONLY comes back
# in development or with VX_ALLOW_DEV_CODE=1, and a real SMS (KAVENEGAR_KEY) is
# required for logins.
# VX_HIDE_CODE=1
# Test mode (no OTP at all): registered phone logs in instantly, new phone only
# asks name/username. Enable ONLY for experimental/testing builds in any env.
# VX_NO_OTP=1

# AI (optional — app runs without it, just no AI replies)
# ─────────────────────────────────────────────────────────────────────────────
# EVERY provider is optional. With none configured the app boots and runs
# normally; AI endpoints answer 503 «هوش مصنوعی تنظیم نشده است.»
# Docs: docs/AI_PROVIDERS.md (Persian)

# Order in which text providers are tried. First healthy one wins; on 429/5xx
# the chain moves to the NEXT one immediately (no sleeping, no retry-storm).
AI_TEXT_CHAIN=nvidia,groq,gemini,openrouter

# --- NVIDIA NIM (OpenAI-compatible) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-405b-instruct

# --- Groq (key rotation: comma-separated) ---
# GROQ_MODEL default is qwen/qwen3.8-27b. (The older qwen/qwen3.6-27b was shut
# down on Groq on 14 Sep 2026 and is no longer used anywhere.)
GROQ_API_KEYS_STR=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Google Gemini (free tier) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- OpenRouter (':free' models only — the suffix is enforced in code) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_SITE_URL=

# --- Image generation (optional; chain = Cloudflare first, then Pollinations) ---
CF_AI_ACCOUNT_ID=
CF_AI_TOKEN=
CF_AI_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Pollinations no longer serves requests without a key, so an empty value means
# "not configured" (it is skipped instead of failing slowly).
POLLINATIONS_API_KEY=

# --- Voice transcription (optional) ---
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
AI_TRANSCRIBE_MAX_BYTES=20971520

# --- Reliability ---
# Circuit breaker: after N consecutive failures a provider is skipped entirely
# until the cooldown expires, so a dead provider never stalls a request.
AI_CIRCUIT_FAILURES=5
AI_CIRCUIT_COOLDOWN_MS=60000
# One jittered retry of the whole chain when only a single provider is
# configured (the only path that ever sleeps).
AI_TEXT_RETRIES=1
AI_TEXT_TIMEOUT_MS=25000
AI_TEXT_MAX_TOKENS=512
AI_LOG_VERBOSE=1

# --- Safety ---
# Max characters of model output kept (longer replies are truncated).
AI_OUTPUT_MAX_CHARS=2000
# Max characters of untrusted data (chat history / user text) sent per request.
AI_DATA_MAX_CHARS=4000

# --- Daily quotas (reset 00:00 UTC; separate budgets for text and images) ---
# 0 disables that tier. Per-user checks are atomic, so concurrent requests
# cannot double-spend the last unit.
AI_QUOTA_USER_TEXT=50
AI_QUOTA_USER_IMAGE=5
AI_QUOTA_GLOBAL_TEXT=5000
AI_QUOTA_GLOBAL_IMAGE=500
# Token budget per user per day (0 = off). Only charged when a provider
# reports usage.
AI_QUOTA_USER_TOKENS=0
# 1 = admins bypass the per-user budget (the global budget still applies).
AI_QUOTA_ADMIN_BYPASS=1

# SMS provider (optional)
KAVENEGAR_SENDER=
KAVENEGAR_KEY=

# Cloudflare R2 (S3-compatible object storage) — persistent uploads across deploys
# Get these from Cloudflare Dashboard > R2 > Manage R2 API tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Base عمومی فایل‌ها (r2.dev public subdomain یا دامنه سفارشی CDN)، مثلا:
#   https://pub-xxxx.r2.dev   یا   https://cdn.example.com
# اگر خالی باشد، پیام‌ها از مسیر /uploads/ (با auth) سرو می‌شوند و دانلود
# وابسته به بالا بودن سرور می‌ماند. برای دانلود server-off مبتنی بر CDN، تنظیم کنید.
R2_PUBLIC_BASE=
