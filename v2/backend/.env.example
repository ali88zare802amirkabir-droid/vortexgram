# Vortex v2 backend env — copy to .env / set in Render dashboard
# Phone numbers (comma separated) that become admin on register + keep sensitive admin rights
ADMIN_PHONES=09942313116
# Frontend origin(s) allowed for CORS, comma separated (no trailing slash)
FRONTEND_ORIGIN=https://your-frontend.vercel.app
# 1 = return OTP code in API response (DEV ONLY). Must be 0 in production.
APP_DEBUG=1
# Writable dir for SQLite + uploads (Render: leave default /var/www/storage)
STORAGE_DIR=
# Optional: Groq key enables Vortex AI auto-replies in bot DMs (server-side only)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
